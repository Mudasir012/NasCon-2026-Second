# =================================================================== #
# OmniFlow - Unified Business Management Platform (.env.example)
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# =================================================================== #

# --- Server & Networking ------------------------------------------- #
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
PUBLIC_ORIGIN=http://localhost:4000

# --- Database (MongoDB) -------------------------------------------- #
MONGODB_URI=mongodb://127.0.0.1:27017/omniflow

# --- Security & Authentication (F1.1, Q1) -------------------------- #
JWT_SECRET=change-this-to-a-secure-random-key-in-production
JWT_EXPIRES_IN=7d

# --- Background SLA Escalation Engine (F3.4, F3.5) ----------------- #
ESCALATION_TICK_MS=5000

# --- Integration 1: Twilio WhatsApp Sandbox / SMS (I1.1 - I1.9) ---- #
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Integration 2: Stripe in Test Mode (I2.1 - I2.8) -------------- #
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Integration 3: Google Calendar OAuth 2.0 (I3.1 - I3.7) -------- #
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/callback

# --- Integration 4: External Notifications (I4.1 - I4.4) ----------- #
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
